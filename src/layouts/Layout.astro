---
import { ClientRouter } from 'astro:transitions';
import Footer from '../components/Footer.astro';
import interFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import '../styles/global.css';
import '../styles/ocean-theme.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'VennStack Studio — Design & Engineering',
  description = 'VennStack Studio brings design and engineering together to craft immersive digital experiences. Explore our capabilities and start a conversation.'
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" data-motion="paused">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07364d" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={interFont} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="ocean-bg" id="ocean-bg" aria-hidden="true" transition:persist></div>
    <canvas id="ocean-canvas" aria-hidden="true"></canvas>
    <div class="grain-overlay" aria-hidden="true"></div>

    <header class="site-header">
      <nav class="site-nav" aria-label="Main navigation">
        <a class="site-nav__brand" href="#hero" aria-label="VennStack Studio, back to top">V<span aria-hidden="true">·</span>S</a>
        <div class="site-nav__links">
          <a href="#projects">Work</a>
          <a href="#about">Studio</a>
          <a href="#contact">Contact</a>
        </div>
      </nav>
      <div class="experience-controls" role="group" aria-label="Experience preferences">
        <button type="button" id="effects-toggle" aria-pressed="false" aria-describedby="effects-status" hidden>
          <span data-effects-label>Pause effects</span>
        </button>
        <button type="button" id="audio-toggle" aria-label="Ambient sound, Sound off" aria-pressed="false" aria-describedby="audio-status" hidden>
          <span aria-hidden="true">♫</span> <span data-audio-label>Sound off</span>
        </button>
      </div>
      <p class="sr-only" id="effects-status" role="status"></p>
      <p class="sr-only" id="audio-status" role="status"></p>
    </header>

    <div class="depth-hud" id="depth-hud" aria-hidden="true" hidden>
      <div class="depth-hud__zone" id="depth-zone">SURFACE</div>
      <div class="depth-hud__depth">
        <span class="depth-hud__arrow">▼</span>
        <span id="depth-value">0</span><span>m</span>
      </div>
      <div class="depth-hud__pressure"><div id="depth-pressure"></div></div>
    </div>

    <main id="main-content" tabindex="-1"><slot /></main>
    <Footer />

    <style>
      #ocean-canvas { position: fixed; inset: 0; width: 100%; height: 100%; z-index: var(--z-bubbles); pointer-events: none; visibility: hidden; }
      :global(html[data-renderer="ready"]) #ocean-canvas { visibility: visible; }
      .grain-overlay { position: fixed; inset: 0; z-index: var(--z-grain); pointer-events: none; opacity: var(--grain-opacity); background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E"); }
      #main-content { position: relative; z-index: var(--z-content); overflow-x: clip; }
      .site-header { position: relative; z-index: var(--z-nav); padding: 1rem var(--container-padding); background: #061c2c; display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; border-bottom: var(--border-subtle); }
      .site-nav { display: flex; align-items: center; gap: clamp(1rem, 4vw, 3rem); }
      .site-nav__brand { color: var(--text-primary); font-size: 1.25rem; font-weight: 600; letter-spacing: -.08em; }
      .site-nav__brand span { color: var(--accent); padding: 0 .15rem; }
      .site-nav__links, .experience-controls { display: flex; gap: .5rem; align-items: center; flex-wrap: wrap; }
      .site-nav a, .experience-controls button { min-height: 44px; display: inline-flex; align-items: center; justify-content: center; padding: .5rem .75rem; border-radius: var(--radius-sm); }
      .site-nav__links a { font-size: .875rem; color: var(--text-primary); }
      .site-nav__links a:hover { background: #12354a; }
      .experience-controls button { gap: .4rem; font: 500 .75rem/1.4 var(--font-mono); color: var(--text-primary); border: 1px solid #617e91; background: #0b293c; }
      .experience-controls button:hover { background: #163c50; }
      .experience-controls button:disabled { cursor: default; }
      .experience-controls:has(button:not([hidden])) { min-height: 44px; }
      .depth-hud { position: fixed; bottom: 1rem; left: 1rem; z-index: var(--z-hud); pointer-events: none; font-family: var(--font-mono); display: grid; gap: .25rem; padding: .6rem .75rem; background: #061c2c; border: var(--border-subtle); border-radius: var(--radius-sm); }
      .depth-hud__zone { font-size: .625rem; letter-spacing: .08em; color: var(--text-secondary); }
      .depth-hud__depth { display: flex; gap: .3rem; align-items: baseline; font-size: .75rem; }
      #depth-value { font-size: 1rem; font-variant-numeric: tabular-nums; }
      .depth-hud__pressure { height: 2px; width: 100%; background: #466178; }
      #depth-pressure { height: 100%; width: 100%; transform: scaleX(0); transform-origin: left; background: var(--accent); }
      @media (max-width: 768px) {
        .site-header { gap: .25rem; padding: .5rem var(--container-padding); }
        .site-nav { justify-content: space-between; width: 100%; gap: .25rem; }
        .site-nav a { padding-inline: .5rem; }
        .experience-controls { width: 100%; justify-content: flex-end; }
        .depth-hud { display: none; }
      }
    </style>

    <script>
      import { mountExperience } from '../scripts/experience';

      let dispose: (() => void) | undefined;
      const unmount = () => { dispose?.(); dispose = undefined; };
      const mount = () => {
        unmount();
        try { dispose = mountExperience(); }
        catch (error) {
          document.documentElement.dataset.motion = 'paused';
          console.error('Experience unavailable; static content remains accessible.', error);
        }
      };
      document.addEventListener('astro:page-load', mount);
      document.addEventListener('astro:before-swap', unmount);
      window.addEventListener('pagehide', unmount);
      window.addEventListener('pageshow', (event) => { if (event.persisted) mount(); });
    </script>
  </body>
</html>
