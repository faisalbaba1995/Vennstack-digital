---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import '../styles/ocean-theme.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'VennStack Studio — Design Studio Crafting Immersive Digital Experiences',
  description = 'VennStack Studio is a creative design studio specializing in immersive web experiences, branding, and digital craft. Dive deeper to discover our work.'
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0077B6" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <title>{title}</title>

    <!-- Fonts preload -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- View Transitions -->
    <ClientRouter />
  </head>
  <body>
    <!-- Ocean background gradient -->
    <div class="ocean-bg" id="ocean-bg" transition:persist></div>

    <!-- Bubble canvas -->
    <canvas id="bubble-canvas" transition:persist></canvas>

    <!-- Grain overlay -->
    <div class="grain-overlay" id="grain-overlay"></div>

    <!-- Depth counter HUD -->
    <div class="depth-hud" id="depth-hud">
      <div class="depth-hud__zone" id="depth-zone">SURFACE</div>
      <div class="depth-hud__depth">
        <span class="depth-hud__arrow">▼</span>
        <span class="depth-hud__value" id="depth-value">0</span>
        <span class="depth-hud__unit">m</span>
      </div>
      <div class="depth-hud__pressure">
        <div class="depth-hud__pressure-bar" id="depth-pressure"></div>
      </div>
    </div>

    <!-- Audio toggle -->
    <button class="audio-toggle" id="audio-toggle" aria-label="Toggle ambient audio">
      <svg class="audio-toggle__icon audio-toggle__icon--on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M11 5L6 9H2v6h4l5 4V5z"/>
        <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"/>
      </svg>
      <svg class="audio-toggle__icon audio-toggle__icon--off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="display:none">
        <path d="M11 5L6 9H2v6h4l5 4V5z"/>
        <line x1="23" y1="9" x2="17" y2="15"/>
        <line x1="17" y1="9" x2="23" y2="15"/>
      </svg>
    </button>

    <!-- Main content -->
    <main id="main-content">
      <slot />
    </main>

    <style>
      /* Bubble canvas */
      #bubble-canvas {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: var(--z-bubbles);
        pointer-events: none;
      }

      /* Grain overlay */
      .grain-overlay {
        position: fixed;
        inset: 0;
        z-index: var(--z-grain);
        pointer-events: none;
        opacity: var(--grain-opacity);
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
        background-repeat: repeat;
        background-size: 256px 256px;
        mix-blend-mode: overlay;
      }

      /* Depth HUD */
      .depth-hud {
        position: fixed;
        bottom: 2rem;
        left: 2rem;
        z-index: var(--z-hud);
        font-family: var(--font-mono);
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
        opacity: 0;
        transform: translateY(10px);
        transition: opacity 0.6s ease, transform 0.6s ease;
      }

      .depth-hud.is-visible {
        opacity: 1;
        transform: translateY(0);
      }

      .depth-hud__zone {
        font-size: 0.625rem;
        font-weight: 600;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--accent);
        text-shadow: 0 0 8px rgba(var(--accent-rgb), 0.4);
      }

      .depth-hud__depth {
        display: flex;
        align-items: baseline;
        gap: 0.25rem;
        color: var(--text-primary);
      }

      .depth-hud__arrow {
        font-size: 0.625rem;
        opacity: 0.5;
        animation: arrow-pulse 2s ease-in-out infinite;
      }

      @keyframes arrow-pulse {
        0%, 100% { opacity: 0.3; }
        50% { opacity: 0.8; }
      }

      .depth-hud__value {
        font-size: 1.25rem;
        font-weight: 500;
        font-variant-numeric: tabular-nums;
        min-width: 4ch;
        text-shadow: 0 0 6px rgba(var(--accent-rgb), 0.3);
      }

      .depth-hud__unit {
        font-size: 0.6875rem;
        font-weight: 400;
        opacity: 0.5;
      }

      .depth-hud__pressure {
        width: 60px;
        height: 2px;
        background: rgba(var(--accent-rgb), 0.15);
        border-radius: 1px;
        overflow: hidden;
      }

      .depth-hud__pressure-bar {
        height: 100%;
        width: 0%;
        background: var(--accent);
        border-radius: 1px;
        box-shadow: 0 0 6px var(--accent);
        transition: width 0.3s ease;
      }

      /* Audio toggle */
      .audio-toggle {
        position: fixed;
        top: 2rem;
        right: 2rem;
        z-index: var(--z-hud);
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--text-muted);
        transition: color var(--transition-fast), transform var(--transition-fast);
        opacity: 0;
      }

      .audio-toggle.is-visible {
        opacity: 1;
      }

      .audio-toggle:hover {
        color: var(--accent);
        transform: scale(1.1);
      }

      .audio-toggle svg {
        width: 20px;
        height: 20px;
      }

      /* Main content */
      #main-content {
        position: relative;
        z-index: var(--z-content);
      }

      /* Responsive */
      @media (max-width: 768px) {
        .depth-hud {
          bottom: 1rem;
          left: 1rem;
        }

        .audio-toggle {
          top: 1rem;
          right: 1rem;
        }
      }
    </style>

    <!-- Core scripts -->
    <script>
      import { initLenis } from '../scripts/lenis-init';
      import { initGSAP } from '../scripts/gsap-init';
      import { initBubbles } from '../scripts/bubble-engine';
      import { initDepthTracker } from '../scripts/depth-tracker';
      import { initAudio } from '../scripts/audio-controller';

      document.addEventListener('astro:page-load', () => {
        const lenis = initLenis();
        initGSAP(lenis);
        initBubbles();
        initDepthTracker();
        initAudio();
      });
    </script>
  </body>
</html>
