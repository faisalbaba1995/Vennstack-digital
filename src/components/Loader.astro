---
// Loader — Ocean entry screen
---

<div class="loader" id="loader">
  <div class="loader__content">
    <div class="loader__gauge">
      <svg class="loader__gauge-ring" viewBox="0 0 120 120">
        <circle cx="60" cy="60" r="54" fill="none" stroke="rgba(72,202,228,0.1)" stroke-width="1.5"/>
        <circle
          class="loader__gauge-progress"
          cx="60" cy="60" r="54"
          fill="none"
          stroke="rgba(72,202,228,0.8)"
          stroke-width="1.5"
          stroke-dasharray="339.292"
          stroke-dashoffset="339.292"
          stroke-linecap="round"
          transform="rotate(-90 60 60)"
        />
      </svg>
      <div class="loader__depth-display">
        <span class="loader__depth-number" id="loader-depth">0</span>
        <span class="loader__depth-unit">m</span>
      </div>
    </div>

    <div class="loader__text">
      <span class="loader__label">PREPARING TO DIVE</span>
      <span class="loader__studio">VENNSTACK STUDIO</span>
    </div>

    <div class="loader__actions" id="loader-actions" style="opacity: 0;">
      <button class="loader__btn loader__btn--primary" id="loader-enter">
        <span>DIVE WITH SOUND</span>
      </button>
      <button class="loader__btn loader__btn--secondary" id="loader-silent">
        SILENT DESCENT
      </button>
    </div>
  </div>

  <!-- Sonar ping rings -->
  <div class="loader__sonar">
    <div class="loader__sonar-ring"></div>
    <div class="loader__sonar-ring" style="animation-delay: 1s;"></div>
    <div class="loader__sonar-ring" style="animation-delay: 2s;"></div>
  </div>
</div>

<style>
  .loader {
    position: fixed;
    inset: 0;
    z-index: var(--z-loader);
    background: #010A26;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.8s ease, visibility 0.8s ease;
  }

  .loader.is-hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .loader__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.5rem;
  }

  .loader__gauge {
    position: relative;
    width: 120px;
    height: 120px;
  }

  .loader__gauge-ring {
    width: 100%;
    height: 100%;
  }

  .loader__gauge-progress {
    transition: stroke-dashoffset 0.1s linear;
    filter: drop-shadow(0 0 6px rgba(72, 202, 228, 0.5));
  }

  .loader__depth-display {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2px;
    font-family: var(--font-mono);
  }

  .loader__depth-number {
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    text-shadow: 0 0 10px rgba(72, 202, 228, 0.5);
  }

  .loader__depth-unit {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-top: 4px;
  }

  .loader__text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .loader__label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    color: var(--text-muted);
    animation: label-pulse 2s ease-in-out infinite;
  }

  @keyframes label-pulse {
    0%, 100% { opacity: 0.4; }
    50% { opacity: 1; }
  }

  .loader__studio {
    font-family: var(--font-heading);
    font-size: 0.875rem;
    font-weight: 200;
    letter-spacing: 0.3em;
    color: var(--text-primary);
  }

  .loader__actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    transition: opacity 0.6s ease;
  }

  .loader__btn {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 0.875rem 2rem;
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
    cursor: pointer;
  }

  .loader__btn--primary {
    background: rgba(72, 202, 228, 0.1);
    border: 1px solid rgba(72, 202, 228, 0.3);
    color: var(--accent);
  }

  .loader__btn--primary:hover {
    background: rgba(72, 202, 228, 0.2);
    border-color: var(--accent);
    box-shadow: 0 0 20px rgba(72, 202, 228, 0.3);
  }

  .loader__btn--secondary {
    background: none;
    border: none;
    color: var(--text-muted);
    font-size: 0.6875rem;
    padding: 0.5rem 1rem;
  }

  .loader__btn--secondary:hover {
    color: var(--text-primary);
  }

  /* Sonar rings */
  .loader__sonar {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .loader__sonar-ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(72, 202, 228, 0.1);
    animation: sonar-expand 3s ease-out infinite;
  }

  @keyframes sonar-expand {
    0% { width: 120px; height: 120px; opacity: 0.4; }
    100% { width: 500px; height: 500px; opacity: 0; }
  }

  @media (max-width: 768px) {
    .loader__gauge { width: 100px; height: 100px; }
    .loader__depth-number { font-size: 1.25rem; }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const loader = document.getElementById('loader');
    const loaderDepth = document.getElementById('loader-depth');
    const loaderActions = document.getElementById('loader-actions');
    const loaderEnter = document.getElementById('loader-enter');
    const loaderSilent = document.getElementById('loader-silent');
    const progressCircle = document.querySelector('.loader__gauge-progress') as SVGCircleElement;

    if (!loader || !loaderDepth || !loaderActions) return;

    const circumference = 339.292;
    let depth = 0;
    const targetDepth = 200;
    const duration = 2000;
    const startTime = performance.now();

    function animateLoader(currentTime: number) {
      const elapsed = currentTime - startTime;
      const progress = Math.min(elapsed / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3); // Ease out cubic

      depth = Math.floor(eased * targetDepth);
      loaderDepth!.textContent = depth.toString();

      if (progressCircle) {
        progressCircle.style.strokeDashoffset = (circumference * (1 - eased)).toString();
      }

      if (progress < 1) {
        requestAnimationFrame(animateLoader);
      } else {
        // Show entry buttons
        if (loaderActions) {
          loaderActions.style.opacity = '1';
        }
        // Change label
        const label = loader?.querySelector('.loader__label');
        if (label) label.textContent = 'READY TO DIVE';
      }
    }

    requestAnimationFrame(animateLoader);

    function enterSite(withSound: boolean) {
      loader?.classList.add('is-hidden');
      if (withSound) {
        // Trigger audio start
        const audioToggle = document.getElementById('audio-toggle');
        audioToggle?.click();
      }
      // Remove from DOM after transition
      setTimeout(() => {
        loader?.remove();
      }, 1000);
    }

    loaderEnter?.addEventListener('click', () => enterSite(true));
    loaderSilent?.addEventListener('click', () => enterSite(false));
  });
</script>
